# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Video outputs & uploads
outputs/
uploads/
*.mp4
!audio.m4a
!audio2.m4a
!audio3.m4a

# Temporary APK & Testing & Backups
*.apk
*.bak
*.tmp
*.swp
*~
scratch/
.playwright-mcp/
.claude/
screenshot_*.png
test_*.png

# Security & Secrets (Strict Protection)
.env
.env.*
*.pem
*.key
*.jks
*.keystore
*.p12
*.pfx

# Android build cache (jika folder android ikut dicadangkan)
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.idea/

# Media preset (mp4) HARUS ikut ter-deploy; tanpa ini Render kehilangan video & musik asli link
!web/runtime/media/**/*.mp4
!web/preset/*.mp4

# Android assets cache exclusion (Jaga agar size APK tetap ramping)
android/app/src/main/assets/web/runtime/media/*
!android/app/src/main/assets/web/runtime/media/.gitkeep
